# Copy to .env (gitignored) and fill in.

# Lichess personal API token, no scopes: https://lichess.org/account/oauth/token
# Enables opening-explorer expansion in the spike.
LICHESS_TOKEN=

# Optional: defaults to `stockfish` on PATH.
# STOCKFISH_PATH=/usr/games/stockfish

# Optional: defaults to <repo>/content.
# SCHOLIA_CONTENT_DIR=

# Optional: contact details (email or URL) added to the User-Agent. Wikimedia's
# API policy asks for this and rate-limits anonymous clients sooner.
# SCHOLIA_CONTACT=

# Game imports (public games; Chess.com's Published Data API needs no auth).
# Single-user for now; these move to per-person profiles once the app exists.
# LICHESS_USERNAME=
# CHESSCOM_USERNAME=
