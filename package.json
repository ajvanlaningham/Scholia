{
  "name": "scholia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "web": "pnpm --filter @scholia/web start",
    "opening": "pnpm --filter @scholia/pipeline cli opening",
    "sources": "pnpm --filter @scholia/pipeline cli sources",
    "course": "pnpm --filter @scholia/pipeline cli course",
    "lessons": "pnpm --filter @scholia/pipeline cli lessons"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
