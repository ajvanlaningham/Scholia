{
  "name": "scholia",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "Alex VanLaningham",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "web": "pnpm --filter @scholia/web start",
    "opening": "pnpm --filter @scholia/pipeline cli opening",
    "sources": "pnpm --filter @scholia/pipeline cli sources",
    "course": "pnpm --filter @scholia/pipeline cli course",
    "lessons": "pnpm --filter @scholia/pipeline cli lessons",
    "refresh": "pnpm --filter @scholia/pipeline cli refresh",
    "new-course": "pnpm --filter @scholia/pipeline cli new-course",
    "new-lesson": "pnpm --filter @scholia/pipeline cli new-lesson"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
